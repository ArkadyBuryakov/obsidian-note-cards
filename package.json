{
  "name": "obsidian-note-cards",
  "version": "0.1.1",
  "description": "Compact card view for notes on Obsidian canvas",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "esbuild main.ts --bundle --external:obsidian --external:electron --format=cjs --target=es2020 --sourcemap=inline --outfile=main.js --watch",
    "lint": "eslint . --max-warnings 0",
    "build": "tsc --noEmit && esbuild main.ts --bundle --external:obsidian --external:electron --format=cjs --target=es2020 --minify --outfile=main.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "monkey-around": "^3.0.0"
  }
}
